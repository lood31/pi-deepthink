{
  "name": "pi-intervention-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Observable, fail-open intervention timing for pi",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "replay": "node replay.ts",
    "report": "node report.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
